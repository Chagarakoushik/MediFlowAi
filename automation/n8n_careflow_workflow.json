{
  "name": "MediFlowAi — Healthcare Follow-up Dispatch Workflow",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "healthcare-followup", "responseMode": "onReceived", "responseData": "allEntries", "options": {} },
      "id": "1b67e234-a120-410e-9271-89d42ab11101",
      "name": "MediFlowAi Inbound Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [260, 340],
      "webhookId": "mediflowai-healthcare-followup"
    },
    {
      "parameters": { "conditions": { "string": [{ "value1": "={{$json.reminder.reviewed_by}}", "operation": "isNotEmpty" }] } },
      "id": "2c78f345-b231-421f-8382-90e53bc22202",
      "name": "Validate Clinical Review Sign-off",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [500, 340]
    },
    {
      "parameters": { "dataType": "string", "value1": "={{$json.reminder.channel}}", "rules": { "rules": [{ "value2": "SMS", "output": 0 }, { "value2": "WhatsApp", "output": 1 }, { "value2": "Email", "output": 2 }, { "value2": "Phone Script", "output": 3 }] } },
      "id": "3d89a456-c342-432a-9493-01f64cd33303",
      "name": "Channel Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [740, 340]
    },
    {
      "parameters": { "from": "+15550192834", "to": "={{$json.patient.phone}}", "message": "={{$json.reminder.message}}" },
      "id": "4e90b567-d453-443b-a504-12a75de44404",
      "name": "Twilio SMS Dispatcher",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [1020, 180]
    },
    {
      "parameters": { "from": "whatsapp:+15550192834", "to": "={{'whatsapp:' + $json.patient.phone}}", "message": "={{$json.reminder.message}}" },
      "id": "5fa1c678-e564-454c-b615-23b86ef55505",
      "name": "WhatsApp Business Dispatcher",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [1020, 320]
    },
    {
      "parameters": {
        "sendTo": "={{$json.patient.email}}",
        "subject": "={{$json.reminder.subject || 'MediFlowAi Follow-up Reminder'}}",
        "emailType": "text",
        "message": "={{$json.reminder.message}}",
        "options": { "senderName": "MediFlowAi Care Coordination", "replyTo": "mediflowai@mediflow-clinic.org" }
      },
      "id": "60b2d789-f675-465d-c726-34c97fa66606",
      "name": "Gmail Notification Dispatcher",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1020, 460],
      "credentials": { "gmailOAuth2": { "id": "mediflowai-gmail-oauth", "name": "MediFlowAi Gmail OAuth2" } }
    },
    {
      "parameters": { "channel": "#clinical-triage-alerts", "text": "=:hospital: *MediFlowAi Phone Concierge Protocol Generated*\n*Patient:* {{$json.patient.name}}\n*Assigned Nurse:* {{$json.reminder.reviewed_by}}\n*Details:* {{$json.appointment.date}} at {{$json.appointment.time}} with {{$json.appointment.doctor}}\n*Script Summary:* {{$json.reminder.message.substring(0, 160)}}..." },
      "id": "71c3e890-a786-476e-d837-45da80b77707",
      "name": "Slack Triage Desk Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [1020, 600]
    },
    {
      "parameters": { "errorMessage": "Healthcare Security Alert: Outbound reminder rejected. Clinical staff review sign-off is missing or invalid." },
      "id": "82d4f901-b897-487f-e948-56eb91c88808",
      "name": "Reject Unreviewed Draft",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [740, 540]
    }
  ],
  "connections": {
    "MediFlowAi Inbound Webhook": { "main": [[{ "node": "Validate Clinical Review Sign-off", "type": "main", "index": 0 }]] },
    "Validate Clinical Review Sign-off": { "main": [[{ "node": "Channel Router", "type": "main", "index": 0 }], [{ "node": "Reject Unreviewed Draft", "type": "main", "index": 0 }]] },
    "Channel Router": { "main": [[{ "node": "Twilio SMS Dispatcher", "type": "main", "index": 0 }], [{ "node": "WhatsApp Business Dispatcher", "type": "main", "index": 0 }], [{ "node": "Gmail Notification Dispatcher", "type": "main", "index": 0 }], [{ "node": "Slack Triage Desk Alert", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
