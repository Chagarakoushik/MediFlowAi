# CareFlow AI Backend Environment Configuration

# Application
ENV=development
DEBUG=True
PORT=8000

# SQLite Database
DATABASE_URL=sqlite:///./careflow.db

# Google Gemini API Key
# Leave empty to run in Demo / Simulated Mode, or paste your Gemini API key from Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# n8n Automation Webhook
N8N_DEFAULT_WEBHOOK_URL=https://n8n.careflow-demo.internal/webhook/healthcare-followup
SIMULATION_MODE_DEFAULT=True
